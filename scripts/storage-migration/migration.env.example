# One-off Phase 5 GCS -> R2 migration environment.
# Keep this file separate from the production API/worker environment and never commit real values.
DATABASE_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_ENDPOINT=
OBJECT_STORAGE_PUBLIC_BASE_URL=

GCS_MIGRATION_PUBLIC_BUCKET_NAME=
GCS_MIGRATION_PRIVATE_BUCKET_NAME=
# Prefer a locked-down file mounted only into the one-off migration shell/job.
GCS_MIGRATION_SERVICE_ACCOUNT_FILE=
# Alternative for secret-manager injection; never store the JSON in source control.
GCS_MIGRATION_SERVICE_ACCOUNT_JSON=

# Cloudflare token with only the permissions required to manage R2 migration jobs/Sippy.
CLOUDFLARE_API_TOKEN=

# Destructive/remote-mutation confirmations; set only for the command being executed.
SIPPY_ENABLE_CONFIRM=
SIPPY_DISABLE_CONFIRM=
SLURPER_CREATE_CONFIRM=
SLURPER_MUTATION_CONFIRM=
GCS_REFERENCE_REWRITE_CONFIRM=
GCS_PRIVATE_REFERENCE_REWRITE_CONFIRM=
