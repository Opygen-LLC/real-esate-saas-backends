    "verify:phase10": "node scripts/verify-phase10-final-matrix.mjs && node scripts/verify-phase10-release.mjs",
    "migrate:phase5-dashboard-ordering": "ts-node --transpile-only src/app/db/migratePhase5DashboardOrdering.ts",
    "migrate:phase8-broker-visibility": "ts-node --transpile-only src/app/db/migratePhase8LicensedBrokerVisibility.ts",
    "migrate:onboarding-four-steps": "ts-node --transpile-only src/app/db/migrateOnboardingToFourSteps.ts",
    "reconcile:phase8-entitlements": "ts-node --transpile-only src/app/db/reconcilePhase8ResourceEntitlements.ts",
    "migrate:starter-lead-entitlement": "ts-node --transpile-only src/app/db/migrateStarterLeadEntitlement.ts",
    "migrate:starter-vnext": "ts-node --transpile-only src/app/db/migrateStarterPlanVNext.ts",
    "migrate:subscription-benefit-periods": "ts-node --transpile-only src/app/db/migrateSubscriptionBenefitPeriods.ts",
    "migrate:continuous-subscription": "ts-node --transpile-only src/app/db/migrateContinuousSubscriptionPolicy.ts",
    "migrate:lead-allowance-reservations": "ts-node --transpile-only src/app/db/migrateLeadAllowanceReservations.ts",
    "migrate:subscription-benefit-streak-adjustments": "ts-node --transpile-only src/app/db/migrateSubscriptionBenefitStreakAdjustments.ts",
    "migrate:subscription-tier-rollover-v2": "ts-node --transpile-only src/app/db/migrateSubscriptionTierRolloverV2.ts",
    "migrate:subscription-deferred-downgrades": "ts-node --transpile-only src/app/db/migrateDeferredSubscriptionSchedules.ts",
    "migrate:lead-subscription-locking": "ts-node --transpile-only src/app/db/migrateLeadSubscriptionLocking.ts",
    "migrate:subscription-release": "ts-node --transpile-only src/app/db/migrateSubscriptionLeadReleaseV1.ts",
    "test:subscription-release": "pnpm test:subscription-release:unit && pnpm test:subscription-release:contract && pnpm test:subscription-release:integration && pnpm test:subscription-release:security",
    "verify:subscription-release": "node scripts/verify-subscription-release.mjs",
    "test:subscription-release:unit": "vitest run src/tests/subscriptionRelease/subscriptionTierRollover.unit.test.ts",
    "test:subscription-release:contract": "vitest run src/tests/subscriptionRelease/subscriptionTierRollover.contract.test.ts",
    "test:subscription-release:integration": "node scripts/require-env.mjs TEST_DATABASE_URL && vitest run src/tests/subscriptionRelease/subscriptionDowngrade.integration.test.ts src/tests/subscriptionRelease/leadLocking.integration.test.ts",
    "test:subscription-release:security": "node scripts/require-env.mjs TEST_DATABASE_URL && vitest run src/tests/subscriptionRelease/leadLocking.security.test.ts"
  },
