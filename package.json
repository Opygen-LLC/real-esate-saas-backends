{
  "name": "real-estate-saas-server",
  "version": "1.0.0",
  "description": "Real Estate SaaS Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node-dev --transpile-only src/app/db/seed.ts",
    "migrate:bdt-plans": "ts-node --transpile-only src/app/db/migratePlansToBdt.ts",
    "migrate:starter-500": "ts-node --transpile-only src/app/db/migrateStarterPlanTo500.ts",
    "migrate:phase-0-1": "ts-node --transpile-only src/app/db/migratePhase01.ts",
    "migrate:phase-2": "ts-node --transpile-only src/app/db/migratePhase2.ts",
    "start": "node ./dist/server.js",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "migrate:phase-4": "ts-node --transpile-only src/app/db/migratePhase4.ts",
    "migrate:phase-5": "ts-node --transpile-only src/app/db/migratePhase5.ts",
    "migrate:phase-6": "ts-node --transpile-only src/app/db/migratePhase6.ts",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/tests/unit src/app/module/auth/auth.security.test.ts src/app/module/auth/auth.validation.test.ts src/app/module/localization/localization.test.ts",
    "test:contract": "vitest run src/tests/contract",
    "test:integration": "node scripts/require-env.mjs TEST_DATABASE_URL && vitest run src/tests/integration",
    "test:security": "vitest run src/tests/security src/app/module/tenant/tenantIsolation.test.ts src/app/module/auth/auth.security.test.ts",
    "test:ci": "vitest run",
    "test:migrations": "node scripts/require-env.mjs TEST_DATABASE_URL && node scripts/verify-migrations.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "verify:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:test && pnpm build && pnpm test:ci",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "migrate:email-otp": "ts-node --transpile-only src/app/db/migrateEmailOtpAuth.ts"
  },
  "keywords": [
    "real-estate",
    "saas",
    "crm",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^6.4.16",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "bangladesh-location-data": "1.0.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "http-status": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.2",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.17.6",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "packageManager": "pnpm@10.27.0"
}
