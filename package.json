{
  "name": "real-estate-saas-server",
  "version": "1.0.0",
  "description": "Real Estate SaaS Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node-dev --transpile-only src/app/db/seed.ts",
    "migrate:bdt-plans": "ts-node --transpile-only src/app/db/migratePlansToBdt.ts",
    "migrate:starter-500": "ts-node --transpile-only src/app/db/migrateStarterPlanTo500.ts",
    "migrate:phase-0-1": "ts-node --transpile-only src/app/db/migratePhase01.ts",
    "migrate:phase-2": "ts-node --transpile-only src/app/db/migratePhase2.ts",
    "start": "node ./dist/server.js",
    "build": "tsc && node scripts/copy-brand-assets.mjs",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "migrate:phase-4": "ts-node --transpile-only src/app/db/migratePhase4.ts",
    "migrate:phase-5": "ts-node --transpile-only src/app/db/migratePhase5.ts",
    "migrate:phase-6": "ts-node --transpile-only src/app/db/migratePhase6.ts",
