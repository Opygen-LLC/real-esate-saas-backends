    "migrate:access-restrictions": "ts-node --transpile-only src/app/db/migrateAccessRestrictionProvenance.ts",
    "migrate:website-submissions": "ts-node --transpile-only src/app/db/migrateWebsiteSubmissions.ts",
    "migrate:property-draft-assets": "ts-node --transpile-only src/app/db/migratePropertyDraftAssets.ts",
    "migrate:domain-lifecycle": "ts-node --transpile-only src/app/db/migratePhase9DomainLifecycle.ts",
