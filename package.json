    "migrate:phase-1-manual-subscriptions": "ts-node --transpile-only src/app/db/migratePhase1ManualSubscriptions.ts",
    "migrate:phase-3-agency-publishing": "ts-node --transpile-only src/app/db/migratePhase3AgencyPublishing.ts",
    "migrate:phase-4-media": "ts-node --transpile-only src/app/db/migratePhase4PropertyMedia2.ts",
