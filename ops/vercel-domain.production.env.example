# Merge these values into the backend production .env.
# Never commit the real VERCEL_API_TOKEN.

DOMAIN_PROVIDER=vercel
PUBLIC_SITE_ORIGIN=https://realestate.opygen.com
VERCEL_PROJECT_ID_OR_NAME=your-vercel-project-id-or-name
VERCEL_API_TOKEN=replace-with-a-real-server-side-vercel-token

# Set these when the project/token is scoped to a Vercel team.
VERCEL_TEAM_ID=
VERCEL_REQUIRE_TEAM_ID=false

# Existing live-domain replacement grace period.
DOMAIN_REPLACEMENT_GRACE_HOURS=168

# Vercel recommendations are fetched dynamically. Do not set DOMAIN_A_TARGET
# or DOMAIN_CNAME_TARGET for production Vercel custom domains.
