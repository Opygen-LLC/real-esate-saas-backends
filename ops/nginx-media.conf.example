# Reverse proxy for browser-facing S3-compatible property media.
# Keep the MinIO API bound to 127.0.0.1:9000 and terminate TLS here (or at your existing edge proxy).
server {
    listen 443 ssl http2;
    server_name media.realestate.opygen.com;

    ssl_certificate     /etc/letsencrypt/live/media.realestate.opygen.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/media.realestate.opygen.com/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:9000;
    }
}
