NODE_ENV=development
PORT=5000

# Development/test delivery modes. Production startup requires EMAIL_DEV_MODE=false.
SMS_DEV_MODE=true
EMAIL_DEV_MODE=true

# Core URLs / database
# Production: use a dedicated least-privilege MongoDB user, a named application database, TLS, and a provider/network allowlist that exposes MongoDB only to the backend/approved egress.
# Example shape only (do not commit real credentials): mongodb+srv://APP_USER:REDACTED@cluster.example/realestate?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27018/phase1_local?replicaSet=rs0&directConnection=true
PUBLIC_API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
PUBLIC_SITE_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Generate unique production values (32+ random bytes) and keep them outside source control.
NEXT_REVALIDATE_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=
CRON_SIGNING_SECRET=
DATA_ENCRYPTION_KEY=

BCRYPT_SALT_ROUNDS=12
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMTP. EMAIL_DEV_MODE=true always simulates delivery and never sends externally.
# Production requires EMAIL_DEV_MODE=false plus all SMTP fields below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=
SMTP_VERIFY_ON_STARTUP=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000
SMTP_HEALTH_CACHE_MS=60000
SMTP_MAX_ATTEMPTS=2
SMTP_RETRY_DELAY_MS=500

# Cloudflare R2 object storage (S3-compatible). Create bucket-scoped Read & Write access keys.
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
# Dedicated non-public bucket for property documents, supplier invoices, and support attachments.
R2_PRIVATE_BUCKET_NAME=
# Optional: derived from R2_ACCOUNT_ID when omitted.
R2_ENDPOINT=
# Public r2.dev or custom-domain base URL for the public bucket only. Never point this at the private bucket.
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Production browser origin allowed to use presigned R2 URLs.
OBJECT_STORAGE_BROWSER_ORIGIN=https://realestate.opygen.com
# Used only by scripts/setup-r2-cors.mjs when NODE_ENV is not production.
OBJECT_STORAGE_DEVELOPMENT_ORIGINS=http://localhost:3000,http://localhost:3001
OBJECT_STORAGE_SIGNED_URL_TTL=600

# Custom-domain routing
DOMAIN_PROVIDER=generic
DOMAIN_A_TARGET=
DOMAIN_CNAME_TARGET=
VERCEL_PROJECT_ID_OR_NAME=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_REQUIRE_TEAM_ID=false

# Redis / realtime / distributed abuse protection
# Production requires Redis even when realtime is disabled because rate limits
# and daily usage budgets must be shared across every API replica.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_ALLOW_INSECURE_PRIVATE_NETWORK=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_KEY_PREFIX=re-saas
REDIS_CACHE_NAMESPACE=cache
REDIS_QUEUE_NAMESPACE=queue

# Workers
WORKER_ENABLED=false

# Read-only Finance audit tuning
FINANCE_AUDIT_ACTIVATING_STALE_MINUTES=30

# Database backups
# Production backups should use a separate authenticated/TLS destination or protected object-storage export; retain multiple recovery points and test restore drills.
BACKUP_DATABASE_URL=
BACKUP_CRON=15 3 * * *
BACKUP_TIMEZONE=Asia/Dhaka
BACKUP_DATABASE_PREFIX=re_backup
BACKUP_MANIFEST_DATABASE_NAME=re_backup_control
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_RECOVERY_POINTS=7
BACKUP_PROCESS_TIMEOUT_MINUTES=120
BACKUP_LOCK_STALE_MINUTES=360
BACKUP_MAX_PARALLEL_COLLECTIONS=4
BACKUP_ALLOW_SAME_CLUSTER=false
BACKUP_WORK_DIR=/tmp/real-estate-db-backup
BACKUP_OBJECT_STORAGE_PROTECTION_MODE=warn

# Explicit trusted edge IPs/CIDRs only. Leave false for direct local API access.
# Production requires this to identify the actual reverse proxy/load balancer;
# never use true, a hop count, or 0.0.0.0/0.
TRUST_PROXY=false
# Production requires a unique random metrics token of at least 32 characters.
METRICS_TOKEN=
# Requests slower than this threshold emit a bounded slow-request security metric/event.
SLOW_REQUEST_MS=1500
# Calendar gateway must enforce Idempotency-Key and monotonically increasing revision.
CALENDAR_PROVIDER_APPROVAL_STATUS=pending
CALENDAR_SYNC_URL=
CALENDAR_SYNC_TOKEN=
CALENDAR_SYNC_TIMEOUT_MS=10000
# Test commands refuse non-local databases or names outside phase1_* .
TEST_DATABASE_URL=mongodb://127.0.0.1:27018/phase1_integration?replicaSet=rs0&directConnection=true

# Phase 5 website renderer rollout: disabled | opt-in | new-sites
# Existing tenants without a marker always resolve to legacy-v1 until explicitly migrated/adopted.
WEBSITE_RENDERER_ROLLOUT_MODE=disabled
# Optional comma-separated organizationId pilot cohort. Empty means every eligible tenant for the selected mode.
WEBSITE_RENDERER_ROLLOUT_ORGANIZATIONS=

# Production reverse proxy / automatic TLS (Caddy hostname only, no path)
CADDY_SITE_ADDRESS=
